# Database
DATABASE_URL=mysql+pymysql://campus_user:campus123@localhost:8881/campus_monitor

# Cache / Celery broker
REDIS_URL=redis://localhost:8880/0

# Runtime
# development | production（production 下若仍使用占位密钥会拒绝启动）
ENVIRONMENT=development
# 统计自然日与 Celery 调度共用的业务时区（数据库始终存 UTC）
BUSINESS_TIMEZONE=Asia/Shanghai

# JWT
SECRET_KEY=change-me-to-a-random-secret
# 与 config.py 默认值保持一致（此前此处为 30，会导致复制模板后有效期从 24h 缩到 30min）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Key (用于日志写入接口 X-API-Key 头校验)
API_KEY=dev-api-key-change-in-production

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
ALERT_EMAIL_FROM=campus-monitor@localhost
